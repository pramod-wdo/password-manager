<h1>Entries</h1>
<div class="row">
  <div class="card">
    <div class="card-body">
      <% if @entries.any? %>
        <%= render @entries %>
      <% else %>
        <h2>
          No entries found. <%= link_to ("Add an Entry", new_entry_path) %>
        </h2>
      <% end %>
    </div>
  </div>
</div>
